{
  "actorSpecification": 1,
  "name": "paginegialle-scraper",
  "title": "PagineGialle.it — Italian Yellow Pages Business Scraper",
  "description": "Extract business leads from PagineGialle.it — Italy's #1 business directory. Get names, phones, addresses, ratings and profile URLs. Select categories and cities from dropdowns. No coding needed.",
  "version": "0.2",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "readme": "./README.md",
  "input": "./input_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Business Listings",
          "transformation": {
            "fields": [
              "name",
              "category",
              "phone",
              "email",
              "website",
              "address",
              "city",
              "province",
              "postalCode",
              "latitude",
              "longitude",
              "rating",
              "reviewCount",
              "facebook",
              "instagram",
              "profileUrl",
              "searchCategory",
              "searchCity"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "name": {
                "label": "Business Name",
                "format": "text"
              },
              "category": {
                "label": "Category",
                "format": "text"
              },
              "phone": {
                "label": "Phone",
                "format": "text"
              },
              "address": {
                "label": "Address",
                "format": "text"
              },
              "city": {
                "label": "City",
                "format": "text"
              },
              "rating": {
                "label": "Rating",
                "format": "number"
              },
              "profileUrl": {
                "label": "Profile URL",
                "format": "link"
              },
              "searchCategory": {
                "label": "Search Category",
                "format": "text"
              },
              "searchCity": {
                "label": "Search City",
                "format": "text"
              }
            }
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}